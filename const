<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Cloy Style</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg: #08080c;
            --card: #111116;
            --card-hover: #17171e;
            --border: rgba(255,255,255,.08);
            --border-hover: rgba(255,255,255,.16);
            --text: #f5f5f7;
            --muted: #8e8e99;
            --accent: #8b5cf6;
            --accent-light: #a78bfa;
        }

        body {
            min-height: 100vh;
            font-family: "Inter", sans-serif;
            color: var(--text);
            background:
                radial-gradient(
                    circle at 50% -10%,
                    rgba(139, 92, 246, .15),
                    transparent 40%
                ),
                var(--bg);
            overflow-x: hidden;
        }

        body::before {
            content: "";
            position: fixed;
            inset: 0;
            pointer-events: none;
            background-image:
                linear-gradient(
                    rgba(255,255,255,.018) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(255,255,255,.018) 1px,
                    transparent 1px
                );
            background-size: 45px 45px;
            mask-image: linear-gradient(to bottom, black, transparent 80%);
        }

        /* ==============================
           HEADER
        ============================== */

        header {
            width: 100%;
            height: 76px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-bottom: 1px solid var(--border);
            background: rgba(8, 8, 12, .72);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
            position: sticky;
            top: 0;
            z-index: 20;
        }

        .header-inner {
            width: min(1100px, calc(100% - 40px));
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -.6px;
        }

        .logo span {
            color: var(--accent-light);
        }

        .status {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--muted);
            font-size: 13px;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #7c3aed;
            box-shadow: 0 0 12px rgba(124, 58, 237, .8);
        }

        /* ==============================
           MAIN
        ============================== */

        main {
            width: min(1100px, calc(100% - 40px));
            margin: 0 auto;
            padding: 90px 0 100px;
        }

        .hero {
            text-align: center;
            max-width: 750px;
            margin: 0 auto 65px;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 12px;
            border: 1px solid var(--border);
            background: rgba(255,255,255,.025);
            border-radius: 999px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 500;
            margin-bottom: 24px;
        }

        .hero-badge span {
            color: var(--accent-light);
        }

        h1 {
            font-size: clamp(42px, 7vw, 76px);
            line-height: .98;
            letter-spacing: -4px;
            font-weight: 800;
            margin-bottom: 22px;
        }

        h1 span {
            color: var(--accent-light);
        }

        .hero p {
            color: var(--muted);
            font-size: 16px;
            line-height: 1.7;
            max-width: 570px;
            margin: auto;
        }

        /* ==============================
           DOCUMENT CARD
        ============================== */

        .documents-title {
            margin-bottom: 18px;
        }

        .documents-title h2 {
            font-size: 14px;
            font-weight: 600;
            color: #d6d6dc;
        }

        .documents-title p {
            margin-top: 5px;
            color: #6f6f79;
            font-size: 13px;
        }

        .document-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 18px;
        }

        .document-card {
            width: 100%;
            border: 1px solid var(--border);
            background:
                linear-gradient(
                    145deg,
                    rgba(255,255,255,.045),
                    rgba(255,255,255,.015)
                ),
                var(--card);
            border-radius: 18px;
            padding: 20px;
            text-align: left;
            cursor: pointer;
            color: var(--text);
            transition:
                transform .25s ease,
                border-color .25s ease,
                background .25s ease,
                box-shadow .25s ease;
        }

        .document-card:hover {
            transform: translateY(-4px);
            border-color: var(--border-hover);
            background: var(--card-hover);
            box-shadow: 0 18px 50px rgba(0,0,0,.3);
        }

        .document-preview {
            height: 180px;
            width: 100%;
            border-radius: 12px;
            overflow: hidden;
            background: #0c0c10;
            border: 1px solid rgba(255,255,255,.06);
            margin-bottom: 18px;
        }

        .document-preview img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
            transition: transform .35s ease;
        }

        .document-card:hover .document-preview img {
            transform: scale(1.035);
        }

        .document-icon {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(139,92,246,.12);
            border: 1px solid rgba(139,92,246,.2);
            margin-bottom: 15px;
            color: var(--accent-light);
        }

        .document-icon svg {
            width: 21px;
            height: 21px;
        }

        .document-name {
            font-size: 16px;
            font-weight: 700;
            line-height: 1.4;
            margin-bottom: 7px;
        }

        .document-description {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.55;
        }

        .document-arrow {
            margin-top: 18px;
            color: #777780;
            font-size: 13px;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .document-arrow span {
            transition: transform .2s ease;
        }

        .document-card:hover .document-arrow span {
            transform: translateX(4px);
        }

        /* ==============================
           MODAL
        ============================== */

        .modal-overlay {
            position: fixed;
            inset: 0;
            z-index: 100;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;

            background: rgba(0,0,0,.72);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);

            opacity: 0;
            visibility: hidden;
            transition:
                opacity .25s ease,
                visibility .25s ease;
        }

        .modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        .modal {
            width: min(570px, 100%);
            max-height: calc(100vh - 40px);
            overflow-y: auto;

            border: 1px solid rgba(255,255,255,.1);
            border-radius: 22px;

            background:
                radial-gradient(
                    circle at 50% 0%,
                    rgba(139,92,246,.1),
                    transparent 45%
                ),
                #101014;

            box-shadow:
                0 30px 100px rgba(0,0,0,.6),
                0 0 0 1px rgba(255,255,255,.025);

            transform: translateY(18px) scale(.97);
            transition: transform .3s cubic-bezier(.2,.8,.2,1);
        }

        .modal-overlay.active .modal {
            transform: translateY(0) scale(1);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding: 22px 22px 0;
        }

        .modal-title {
            font-size: 19px;
            line-height: 1.35;
            font-weight: 750;
            padding-right: 20px;
        }

        .modal-subtitle {
            margin-top: 5px;
            color: var(--muted);
            font-size: 12px;
        }

        .close-button {
            flex-shrink: 0;
            width: 34px;
            height: 34px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: rgba(255,255,255,.035);
            color: #aaaab2;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: .2s ease;
        }

        .close-button:hover {
            background: rgba(255,255,255,.08);
            color: white;
        }

        .modal-body {
            padding: 22px;
        }

        .modal-preview {
            width: 100%;
            height: 300px;
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid var(--border);
            background: #09090c;
        }

        .modal-preview img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: contain;
        }

        .warning {
            display: flex;
            gap: 11px;
            align-items: flex-start;

            margin-top: 15px;
            padding: 13px 14px;

            border: 1px solid rgba(245,158,11,.14);
            background: rgba(245,158,11,.055);
            border-radius: 12px;

            color: #aaa29a;
            font-size: 12px;
            line-height: 1.55;
        }

        .warning svg {
            flex-shrink: 0;
            width: 17px;
            height: 17px;
            margin-top: 1px;
            color: #d49b3d;
        }

        .open-button {
            width: 100%;
            height: 48px;
            margin-top: 15px;

            border: 0;
            border-radius: 12px;

            background: var(--accent);
            color: white;

            font-family: inherit;
            font-size: 14px;
            font-weight: 700;

            cursor: pointer;

            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;

            text-decoration: none;

            box-shadow: 0 8px 25px rgba(139,92,246,.2);
            transition:
                transform .2s ease,
                background .2s ease,
                box-shadow .2s ease;
        }

        .open-button:hover {
            background: #7c3aed;
            transform: translateY(-1px);
            box-shadow: 0 12px 32px rgba(139,92,246,.3);
        }

        .open-button svg {
            width: 17px;
            height: 17px;
        }

        /* ==============================
           FOOTER
        ============================== */

        footer {
            width: min(1100px, calc(100% - 40px));
            margin: 0 auto;
            padding: 0 0 30px;

            color: #55555f;
            font-size: 12px;
            text-align: center;
        }

        /* ==============================
           MOBILE
        ============================== */

        @media (max-width: 600px) {
            header {
                height: 66px;
            }

            .header-inner {
                width: calc(100% - 28px);
            }

            .status {
                display: none;
            }

            main {
                width: calc(100% - 28px);
                padding-top: 65px;
            }

            h1 {
                letter-spacing: -2.5px;
            }

            .hero {
                margin-bottom: 45px;
            }

            .hero p {
                font-size: 14px;
            }

            .document-grid {
                grid-template-columns: 1fr;
            }

            .modal {
                border-radius: 18px;
            }

            .modal-preview {
                height: 230px;
            }

            .modal-body,
            .modal-header {
                padding-left: 17px;
                padding-right: 17px;
            }
        }
    </style>
</head>

<body>

    <!-- HEADER -->
