    </div>

</div>

    <!-- JAVASCRIPT -->
    <script>
const documentButtonNoAnswers =
    document.getElementById("socialStudiesNoAnswersButton");

const modalNoAnswers =
    document.getElementById("documentModalNoAnswers");

const closeButtonNoAnswers =
    document.getElementById("closeModalNoAnswers");


function openModalNoAnswers() {
    modalNoAnswers.classList.add("active");
    modalNoAnswers.setAttribute("aria-hidden", "false");

    document.body.style.overflow = "hidden";
}


function closeModalNoAnswers() {
    modalNoAnswers.classList.remove("active");
    modalNoAnswers.setAttribute("aria-hidden", "true");

    document.body.style.overflow = "";
}


documentButtonNoAnswers.addEventListener(
    "click",
    openModalNoAnswers
);

closeButtonNoAnswers.addEventListener(
    "click",
    closeModalNoAnswers
);


modalNoAnswers.addEventListener("click", function(event) {

    if (event.target === modalNoAnswers) {
        closeModalNoAnswers();
    }

});


document.addEventListener("keydown", function(event) {

    if (event.key === "Escape") {
        closeModalNoAnswers();
    }

});
        
        const documentButton =
            document.getElementById("socialStudiesButton");

        const modal =
            document.getElementById("documentModal");

        const closeButton =
            document.getElementById("closeModal");


        function openModal() {
            modal.classList.add("active");
            modal.setAttribute("aria-hidden", "false");

            document.body.style.overflow = "hidden";
        }


        function closeModal() {
            modal.classList.remove("active");
            modal.setAttribute("aria-hidden", "true");

            document.body.style.overflow = "";
        }


        documentButton.addEventListener("click", openModal);

        closeButton.addEventListener("click", closeModal);


        modal.addEventListener("click", function(event) {
            if (event.target === modal) {
                closeModal();
            }
        });


        document.addEventListener("keydown", function(event) {

            if (event.key === "Escape") {
                closeModal();
            }

        });
    </script>

